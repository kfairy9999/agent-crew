{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "types": []
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker/**/*.ts",
    "src/core/**/*.ts",
    "src/llm/**/*.ts",
    "src/tools/**/*.ts",
    "src/demo/**/*.ts",
    "src/persist/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}

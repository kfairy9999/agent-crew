{
  "name": "agent-crew",
  "version": "1.0.0",
  "private": true,
  "description": "A planner, researcher, writer, and critic collaborate on a short cited brief, streamed live. Portfolio project by Kevin Fairley.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite --host 127.0.0.1 --port 43123\" \"npm run dev:api\"",
    "dev:api": "PORT=44731 tsx src/server/node.ts",
    "dev:worker": "wrangler dev --port 44732",
    "build": "vite build",
    "typecheck": "wrangler types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "PORT=43123 SERVE_STATIC=1 tsx src/server/node.ts",
    "cf-typegen": "wrangler types"
  },
  "author": "Kevin Fairley",
  "license": "MIT",
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "mongodb": "^6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
